# Copy to production.env and replace paths. Never put credentials in this file.
# Build and test this versioned image before starting production.
TC_IMAGE=transcriber-workbench:REPLACE_WITH_RELEASE
TC_PORT=8000
TC_HOST_DATA=/srv/transcriber/data
TC_ENV_FILE=/srv/transcriber-secrets/worker.env
TC_MODEL_CACHE=/srv/transcriber/model-cache
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
